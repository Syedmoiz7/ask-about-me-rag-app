# Copy this file to .env and fill in your values. Never commit .env.
# Leave LLM_API_KEY empty to run in retrieval-only mode (no LLM, no cost).

# --- Option A: Google Gemini (free tier) -------------------------------
# Key from https://aistudio.google.com/apikey
# Use a "flash" model (free tier). Old names get retired; check AI Studio if you get a 404.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# --- Option B: OpenAI (paid credits) -----------------------------------
# Key from https://platform.openai.com/api-keys
# Leave LLM_BASE_URL empty to use OpenAI's default URL.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_MODEL=<a small, current OpenAI model, see platform.openai.com/docs/models>

# Max seconds to wait for the LLM per attempt (1 retry). Default 10.
# LLM_TIMEOUT=10
